{
  "$schema": "https://raw.githubusercontent.com/apmantza/pi-lens/master/docs/schema/pi-lens-config-v1.json",
  "ignore": ["target/**", "**/target/**", ".codegraph/**", "questdb/**"],
  "maxProjectFiles": 100,
  "reviewGraph": { "maxFiles": 100 },
  "startup": { "mode": "minimal", "scans": { "enabled": false } },
  "format": { "enabled": false },
  "autofix": { "enabled": false },
  "actionableWarnings": { "autoFix": { "enabled": false } },
  "knip": { "enabled": false },
  "jscpd": { "enabled": false },
  "madge": { "enabled": false },
  "gitleaks": { "enabled": false },
  "govulncheck": { "enabled": false },
  "deadCode": { "enabled": false },
  "complexity": { "enabled": false },
  "lsp": { "disabledServers": ["rust"] },
  "tools": {
    "ast_grep_search": { "enabled": false },
    "ast_grep_replace": { "enabled": false },
    "ast_grep_outline": { "enabled": false },
    "lsp_navigation": { "enabled": false },
    "lens_diagnostics": { "enabled": false },
    "lens_diagnostic_mark": { "enabled": false },
    "symbol_search": { "enabled": false },
    "module_report": { "enabled": false },
    "project_report": { "enabled": false },
    "read_symbol": { "enabled": false },
    "read_enclosing": { "enabled": false },
    "effective_config": { "enabled": false },
    "analyze": { "enabled": false },
    "health": { "enabled": false },
    "latency": { "enabled": false },
    "project_scan": { "enabled": false },
    "rebuild": { "enabled": false }
  }
}
