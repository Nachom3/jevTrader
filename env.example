# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=
POLYMARKET_PRIVATE_KEY=
QUESTDB_HTTP_URL=http://127.0.0.1:9002
QUESTDB_ILP_ADDR=127.0.0.1:9009
RUST_LOG=info
# Quant pre-processor (RustQuant_math): 0 = off (quant: null), 1 = on.
QUANT_FEATURES_ENABLED=0
QUANT_MIN_VOL_PCT=0.000001
QUANT_Z_VOL_SOURCE=short_1m
QUANT_HORIZON_SCALING=1
# Versioned market spec (see markets/). One file per market: question, source,
# rules, target, resolution timestamp. No market data in env.
JEVTRADER_MARKET_FILE=markets/bitcoin-above-82k-on-september-19-2026.md
# Fixed paper size (no sizing model in V1).
JEVTRADER_MARKET_SIZE=10
# Optional Jev deadline in ms (sensible default when omitted).
JEV_DEADLINE_MS=1500
