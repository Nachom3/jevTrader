# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=
POLYMARKET_PRIVATE_KEY=
QUESTDB_HTTP_URL=http://127.0.0.1:9000
QUESTDB_ILP_ADDR=127.0.0.1:9009
DATABASE_URL=postgres://jevtrader:jevtrader@127.0.0.1:5432/jevtrader
RUST_LOG=info
# Quant pre-processor (RustQuant_math): 0 = off (quant: null), 1 = on.
QUANT_FEATURES_ENABLED=0
QUANT_MIN_VOL_PCT=0.000001
QUANT_Z_VOL_SOURCE=short_1m
QUANT_HORIZON_SCALING=1
